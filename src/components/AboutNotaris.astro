---
import { Icon } from 'astro-icon/components';
import { photos } from '../lib/photos';

const certifications = [
  { icon: 'ph:certificate', label: 'Diangkat Menkumham RI — SK No. AHU-XXX/2012' },
  { icon: 'ph:buildings', label: 'Anggota Ikatan Notaris Indonesia (INI)' },
  { icon: 'ph:graduation-cap', label: 'Magister Kenotariatan, Universitas Indonesia' },
  { icon: 'ph:briefcase', label: 'Lebih dari 12 tahun praktik kenotariatan' },
];
const team = [
  { name: 'Andi Pranata, S.H., M.Kn.', role: 'Notaris & PPAT', photo: photos.portraitAndi },
  { name: 'Tika Hartono, S.H., M.Kn.', role: 'Partner Notaris · bergabung 2020', photo: photos.portraitTika },
  { name: 'Reza Wijaya, S.H.', role: 'Senior Legal Staff', photo: photos.portraitReza },
];
---

<section id="tentang" class="section-space border-t border-hairline">
  <div class="section-shell">
    <div class="about-grid">
      <figure class="about-photo">
        <img src={photos.office} srcset={`${photos.office.replace('.webp', '-small.webp')} 640w, ${photos.office} 1400w`} sizes="(max-width: 640px) calc(100vw - 40px), 48vw" width="1400" height="934" alt="Ilustrasi ruang pertemuan profesional dengan meja kayu dan cahaya alami" loading="lazy" />
        <p>Setiap keputusan penting layak mendapat perhatian penuh.</p>
        <figcaption class="photo-caption">Foto suasana ilustratif · bukan kantor sebenarnya.</figcaption>
      </figure>
      <div class="about-copy">
        <h2 class="section-heading">Ketelitian hukum.<br />Pendekatan yang personal.</h2>
        <p class="section-lead">Kantor Notaris Pranata &amp; Partners didirikan oleh Andi Pranata, S.H., M.Kn., pada tahun 2012. Kami melayani Jakarta Selatan dan sekitarnya, dengan perhatian khusus pada akta keluarga, properti, dan korporasi.</p>
        <p class="section-lead">Dari konsultasi pertama hingga penyerahan akta, kebutuhan Anda menjadi dasar setiap penjelasan, persiapan, dan langkah yang kami tempuh.</p>
        <ul class="certifications">
          {certifications.map((cert) => <li><Icon name={cert.icon} class="mt-1 h-4 w-4 shrink-0 text-accent-gold" /><span>{cert.label}</span></li>)}
        </ul>
        <p class="photo-caption">Profil &amp; kredensial di atas adalah contoh untuk proyek portofolio, belum terverifikasi.</p>
        <a href="#kontak" class="text-link mt-5">Mari bicarakan kebutuhan Anda <Icon name="ph:arrow-right" class="h-4 w-4" /></a>
      </div>
    </div>
    <div class="team-section">
      <div class="team-intro">
        <h3>Orang di balik setiap akta.</h3>
        <p>Tim notaris dan legal, didukung 4 staf administratif untuk kelancaran proses. Nama, profil, dan potret berikut merupakan ilustrasi proyek.</p>
      </div>
      <div class="team-grid">
        {team.map((member) => (
          <article>
            <img src={member.photo} srcset={`${member.photo.replace('.webp', '-small.webp')} 640w, ${member.photo} 800w`} sizes="(max-width: 640px) calc(100vw - 40px), 30vw" width="800" height="1200" loading="lazy" alt={`Foto stock untuk ilustrasi profil ${member.name}, bukan potret orang yang bersangkutan`} />
            <h4>{member.name}</h4>
            <p class="team-role">{member.role}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
