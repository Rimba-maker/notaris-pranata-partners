---
import { Icon } from 'astro-icon/components';
import { photos } from '../lib/photos';
const services = [
  'Akta Tanah & Properti', 'Akta Keluarga', 'Akta Perusahaan & Bisnis',
  'Akta Perjanjian Bisnis', 'Akta Keuangan & Hutang', 'Legalisasi & Waarmerking',
  'Pengurusan & Pendaftaran', 'Akta Wasiat & Hibah',
];
---

<section id="kontak" class="section-space contact-section">
  <div class="section-shell contact-grid">
    <div class="contact-copy">
      <h2 class="section-heading">Langkah pertama.<br />Ketenangan selanjutnya.</h2>
      <p>Konsultasi awal 30 menit gratis. Ceritakan kebutuhan Anda, kami bantu menjelaskan pilihan layanan, dokumen, dan estimasi biaya.</p>
      <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" class="text-link"><Icon name="ph:whatsapp-logo" class="h-5 w-5" /> Konsultasi via WhatsApp <Icon name="ph:arrow-up-right" class="h-4 w-4" /></a>
      <figure>
        <img src={photos.review} srcset={`${photos.review.replace('.webp', '-small.webp')} 640w, ${photos.review} 1400w`} sizes="(max-width: 640px) calc(100vw - 40px), 40vw" width="1400" height="935" alt="Ilustrasi pembahasan dokumen saat konsultasi profesional" loading="lazy" />
        <figcaption class="photo-caption">Foto konsultasi ilustratif · Pexels. Kontak WhatsApp adalah nomor contoh.</figcaption>
      </figure>
    </div>
    <form name="konsultasi" method="POST" action={import.meta.env.BASE_URL} data-netlify="true" netlify-honeypot="bot-field" class="contact-form" id="contact-form">
      <input type="hidden" name="form-name" value="konsultasi" />
      <p hidden><label>Jangan isi ini: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <div class="form-row">
        <div class="form-field"><label for="nama">Nama lengkap</label><input id="nama" name="nama" type="text" autocomplete="name" required placeholder="Nama Anda" /></div>
        <div class="form-field"><label for="whatsapp">Nomor WhatsApp</label><input id="whatsapp" name="whatsapp" type="tel" autocomplete="tel" required placeholder="08xx xxxx xxxx" /></div>
      </div>
      <div class="form-field"><label for="email">Alamat email</label><input id="email" name="email" type="email" autocomplete="email" required placeholder="nama@email.com" /></div>
      <div class="form-row">
        <div class="form-field">
          <label for="layanan-konsultasi">Layanan yang dibutuhkan</label>
          <select id="layanan-konsultasi" name="layanan" required>
            <option value="" disabled selected>Pilih layanan</option>
            {services.map((service) => <option value={service}>{service}</option>)}
            <option value="Belum yakin">Belum yakin, butuh saran</option>
          </select>
        </div>
        <div class="form-field"><label for="tanggal">Tanggal preferensi</label><input id="tanggal" name="tanggal" type="date" /></div>
      </div>
      <div class="form-field"><label for="pesan">Ceritakan kebutuhan Anda</label><textarea id="pesan" name="pesan" rows="4" placeholder="Informasi singkat untuk membantu persiapan konsultasi."></textarea></div>
      <button type="submit" class="btn contact-submit">Buat Janji Konsultasi <Icon name="ph:arrow-right" class="h-4 w-4" /></button>
      <p class="form-privacy">Konsultasi dan dokumen klien dilindungi kerahasiaan profesi notaris (Pasal 16 UUJN). Jadwal akan dikonfirmasi setelah permintaan diterima.</p>
      <p id="form-status" class="form-status" role="status" hidden></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const date = document.getElementById('tanggal') as HTMLInputElement | null;
  const today = new Date();
  if (date) date.min = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

  document.addEventListener('click', (event) => {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('[data-service]') : null;
    const select = document.getElementById('layanan-konsultasi') as HTMLSelectElement | null;
    if (link?.dataset.service && select) select.value = link.dataset.service;
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!button || button.disabled) return;
    const originalLabel = button.innerHTML;
    button.disabled = true;
    button.textContent = 'Mengirim permintaan…';
    form.setAttribute('aria-busy', 'true');
    if (status) status.hidden = true;
    const body = new URLSearchParams();
    for (const [key, value] of new FormData(form)) if (typeof value === 'string') body.append(key, value);
    try {
      const response = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      form.reset();
      if (status) {
        status.textContent = 'Terima kasih. Permintaan konsultasi telah diterima; tim kami akan menghubungi Anda untuk konfirmasi jadwal.';
        status.hidden = false;
      }
    } catch {
      if (status) {
        status.textContent = 'Permintaan belum terkirim. Data Anda tetap tersimpan di formulir; coba lagi atau hubungi melalui WhatsApp. Pengiriman formulir memerlukan hosting Netlify dengan Forms aktif.';
        status.hidden = false;
      }
    } finally {
      button.disabled = false;
      button.innerHTML = originalLabel;
      form.removeAttribute('aria-busy');
    }
  });
</script>
