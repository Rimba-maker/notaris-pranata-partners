---
const groups = [
  {
    cluster: 'Properti',
    rows: [
      { layanan: 'AJB Properti', biaya: '0.5% - 1% dari NJOP', catatan: 'Min Rp 2.5jt' },
    ],
  },
  {
    cluster: 'Keluarga',
    rows: [
      { layanan: 'Perjanjian Pranikah', biaya: 'Rp 3 jt - 6 jt', catatan: 'Konsultasi termasuk' },
      { layanan: 'Akta Waris', biaya: 'Rp 2 jt - 5 jt', catatan: 'Tergantung kompleksitas' },
      { layanan: 'Akta Hibah', biaya: 'Rp 1.5 jt - 3 jt', catatan: '+ BPHTB' },
      { layanan: 'Akta Wasiat', biaya: 'Rp 1.5 jt - 3 jt', catatan: '' },
    ],
  },
  {
    cluster: 'Perusahaan & Bisnis',
    rows: [
      { layanan: 'Pendirian PT', biaya: 'Rp 4 jt - 7 jt', catatan: 'Belum termasuk PNBP & SK' },
      { layanan: 'Pendirian CV', biaya: 'Rp 2.5 jt - 4 jt', catatan: 'Belum termasuk pendaftaran' },
      { layanan: 'Perubahan Anggaran Dasar', biaya: 'Rp 2 jt - 4 jt', catatan: 'Per perubahan' },
      { layanan: 'Perjanjian Kerja Sama', biaya: 'Rp 1.5 jt - 5 jt', catatan: 'Tergantung pasal & nilai' },
    ],
  },
  {
    cluster: 'Legalisasi',
    rows: [
      { layanan: 'Legalisasi / Waarmerking', biaya: 'Rp 200k - 500k', catatan: 'Per dokumen' },
    ],
  },
];
---

<section id="biaya" class="bg-canvas py-section">
  <div class="mx-auto max-w-4xl px-6">
    <h2 class="section-heading">Referensi Biaya</h2>
    <p class="mt-4 max-w-[65ch] text-base text-body">
      Biaya notaris diatur dalam UU No. 30/2004 dan Permenkumham, dengan
      toleransi negosiasi sesuai kompleksitas. Berikut indikatif yang biasa
      kami terapkan.
    </p>

    <div class="mt-10 overflow-x-auto">
      <table class="w-full min-w-[480px] border-collapse">
        <thead>
          <tr class="bg-hairline">
            <th scope="col" class="px-3 py-2.5 text-left font-mono text-xs uppercase tracking-[0.08em] text-body">
              Layanan
            </th>
            <th scope="col" class="px-3 py-2.5 text-left font-mono text-xs uppercase tracking-[0.08em] text-body">
              Biaya Notaris
            </th>
            <th scope="col" class="px-3 py-2.5 text-left font-mono text-xs uppercase tracking-[0.08em] text-body">
              Catatan
            </th>
          </tr>
        </thead>
        {
          groups.map((group) => (
            <tbody class="border-b border-hairline">
              <tr>
                <th
                  colspan={3}
                  scope="colgroup"
                  class="px-3 pt-4 pb-1 text-left font-mono text-xs uppercase tracking-[0.08em] text-body"
                >
                  {group.cluster}
                </th>
              </tr>
              {group.rows.map((row) => (
                <tr class="border-t border-hairline">
                  <td class="px-3 py-3 text-sm text-ink">{row.layanan}</td>
                  <td class="px-3 py-3 font-display text-sm text-ink">{row.biaya}</td>
                  <td class="px-3 py-3 text-sm text-body">{row.catatan}</td>
                </tr>
              ))}
            </tbody>
          ))
        }
      </table>
    </div>

    <p class="mt-8 text-sm text-body">
      Harga belum termasuk PNBP, pajak (PPh dan BPHTB jika ada), dan biaya
      pendaftaran pemerintah. Konsultasi gratis untuk estimasi akurat.
    </p>
  </div>
</section>
