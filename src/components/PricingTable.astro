---
const groups = [
  {
    cluster: 'Properti',
    rows: [
      { layanan: 'AJB Properti', biaya: '0.5% - 1% dari NJOP', catatan: 'Min Rp 2.5jt' },
    ],
  },
  {
    cluster: 'Keluarga',
    rows: [
      { layanan: 'Perjanjian Pranikah', biaya: 'Rp 3 jt - 6 jt', catatan: 'Konsultasi termasuk' },
      { layanan: 'Akta Waris', biaya: 'Rp 2 jt - 5 jt', catatan: 'Tergantung kompleksitas' },
      { layanan: 'Akta Hibah', biaya: 'Rp 1.5 jt - 3 jt', catatan: '+ BPHTB' },
      { layanan: 'Akta Wasiat', biaya: 'Rp 1.5 jt - 3 jt', catatan: '' },
    ],
  },
  {
    cluster: 'Perusahaan & Bisnis',
    rows: [
      { layanan: 'Pendirian PT', biaya: 'Rp 4 jt - 7 jt', catatan: 'Belum termasuk PNBP & SK' },
      { layanan: 'Pendirian CV', biaya: 'Rp 2.5 jt - 4 jt', catatan: 'Belum termasuk pendaftaran' },
      { layanan: 'Perubahan Anggaran Dasar', biaya: 'Rp 2 jt - 4 jt', catatan: 'Per perubahan' },
      { layanan: 'Perjanjian Kerja Sama', biaya: 'Rp 1.5 jt - 5 jt', catatan: 'Tergantung pasal & nilai' },
    ],
  },
  {
    cluster: 'Legalisasi',
    rows: [
      { layanan: 'Legalisasi / Waarmerking', biaya: 'Rp 200k - 500k', catatan: 'Per dokumen' },
    ],
  },
];
---

<section id="biaya" class="section-space bg-[#f5f6f6]">
  <div class="section-shell pricing-layout">
    <div class="pricing-intro">
      <h2 class="section-heading">Kepastian dimulai<br />dari keterbukaan.</h2>
      <p class="section-lead">Kenali referensi biaya sebelum membuat janji. Besaran akhir menyesuaikan jenis akta, nilai transaksi, dan kompleksitas kebutuhan Anda.</p>
      <a href="#kontak" class="text-link">Minta estimasi untuk kebutuhan Anda</a>
      <p class="pricing-note">Harga belum termasuk PNBP, pajak (PPh dan BPHTB jika ada), dan biaya pendaftaran pemerintah. Konsultasi awal gratis untuk estimasi yang lebih akurat. Angka berikut merupakan referensi ilustratif, bukan penawaran mengikat.</p>
    </div>
    <div>
      <table class="pricing-table">
        <caption>Referensi biaya layanan · nilai indikatif untuk proyek demo</caption>
        <thead>
          <tr>
            <th scope="col">Layanan</th>
            <th scope="col">Biaya Notaris</th>
            <th scope="col">Catatan</th>
          </tr>
        </thead>
        {groups.map((group) => (
          <tbody>
            <tr class="price-group"><th colspan={3} scope="colgroup">{group.cluster}</th></tr>
            {group.rows.map((row) => (
              <tr>
                <td>{row.layanan}</td>
                <td>{row.biaya}</td>
                <td>{row.catatan || 'Sesuai kebutuhan akta'}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </div>
</section>
